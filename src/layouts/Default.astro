---
import '../styles/global.css'
import JsonLd from '../components/JsonLd.astro'
import CookieConsent from '../components/CookieConsent.vue'
import AnnouncementBanner from '../components/AnnouncementBanner.vue'

export interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article' | 'profile'
  lang?: 'en' | 'id'
}

const {
  title = 'Software Engineering Laboratory',
  description = 'Software Engineering Laboratory — Jurusan Teknologi Informasi, Politeknik Negeri Malang. Advancing software engineering education and research.',
  image,
  type = 'website',
  lang = 'en',
} = Astro.props as Props

const fullTitle = `${title} | SE Lab — JTI Polinema`
const siteName = 'SE Lab — JTI Polinema'
const ogLocale = lang === 'id' ? 'id_ID' : 'en_US'
const origin = Astro.site?.origin ?? 'https://se.polinema.ac.id'
const canonical = new URL(Astro.url.pathname, origin).href
const ogImage = image ?? '/og-default.svg'
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, origin).href
const twitterCard = image ? 'summary_large_image' : 'summary'

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: origin,
  inLanguage: lang,
}

const shouldRegisterServiceWorker = import.meta.env.PROD
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=DM+Serif+Display:ital,wght@0,400;1,400&display=swap" rel="stylesheet" />

    <title>{fullTitle}</title>

    <link rel="alternate" type="application/rss+xml" title="SE Lab Blog" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="SE Lab Publications" href="/publications.xml" />

    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />

    <meta name="theme-color" content="#004EA2" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <JsonLd data={websiteJsonLd} />

    <slot name="head" />

    {
      shouldRegisterServiceWorker ? (
        <script is:inline>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
              navigator.serviceWorker.register('/sw.js', { scope: '/' })
            })
          }
        </script>
      ) : (
        <script is:inline>
          if ('serviceWorker' in navigator) {
            // A stale service worker from an earlier production/preview
            // session on this origin can still be actively controlling
            // this page load even in dev mode (unregistering here only
            // stops it from intercepting *future* navigations, not the one
            // that already served this document). If that's the case,
            // force one self-healing reload after unregistering so the
            // very next navigation is guaranteed uncontrolled, instead of
            // leaving it to intermittently race network vs. stale cache on
            // every subsequent page load.
            var wasControlled = !!navigator.serviceWorker.controller
            navigator.serviceWorker
              .getRegistrations()
              .then((registrations) =>
                Promise.all(registrations.map((registration) => registration.unregister())),
              )
              .then(() => {
                if (wasControlled && !sessionStorage.getItem('se-lab-sw-cleared')) {
                  sessionStorage.setItem('se-lab-sw-cleared', '1')
                  window.location.reload()
                }
              })
              .catch(() => {})
          }

          if ('caches' in window) {
            caches
              .keys()
              .then((keys) =>
                Promise.all(
                  keys
                    .filter((key) => key.startsWith('se-lab-'))
                    .map((key) => caches.delete(key)),
                ),
              )
              .catch(() => {})
          }
        </script>
      )
    }

    <script is:inline>
      (function() {
        try {
          var theme = localStorage.getItem('se-lab-theme');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else if (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        } catch(e) {}
      })();
      try {
        const lang = localStorage.getItem('se-lab-lang');
        if (lang === 'en' || lang === 'id') document.documentElement.lang = lang;
      } catch {}
      try {
        const PALETTES = ['compass', 'harbor', 'foundry', 'aurora', 'glacier'];
        const fromUrl = new URLSearchParams(window.location.search).get('palette');
        let palette = null;
        if (fromUrl && PALETTES.includes(fromUrl)) {
          palette = fromUrl;
          localStorage.setItem('se-lab-palette', palette);
        } else {
          const stored = localStorage.getItem('se-lab-palette');
          if (stored && PALETTES.includes(stored)) palette = stored;
        }
        if (palette && palette !== 'compass') {
          document.documentElement.setAttribute('data-palette', palette);
        }
      } catch {}
    </script>
  </head>
  <body>
    <a href="#hero" class="skip-to-content">Skip to content</a>
    <AnnouncementBanner client:load />
    <slot />
    <CookieConsent client:load />
  </body>
</html>
