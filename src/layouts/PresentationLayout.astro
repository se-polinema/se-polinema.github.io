---
import '../styles/global.css'
import { withBase } from '../lib/paths'

export interface Props {
  title: string
  lang?: 'en' | 'id'
}

const { title, lang = 'en' } = Astro.props as Props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | SE Lab Presentation</title>
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon.png')} />

    <!-- Apply dark mode before paint (mirrors Default.astro) -->
    <script is:inline>
      (function() {
        try {
          var theme = localStorage.getItem('se-lab-theme');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else if (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        } catch(e) {}
        try {
          const lang = localStorage.getItem('se-lab-lang');
          if (lang === 'en' || lang === 'id') document.documentElement.lang = lang;
        } catch {}
      })();
    </script>
  </head>
  <body class="presentation-body">
    <slot />
  </body>
</html>

<style>
  .presentation-body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    width: 100vw;
    height: 100vh;
    background: transparent;
  }
</style>
