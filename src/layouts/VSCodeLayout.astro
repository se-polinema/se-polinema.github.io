---
import Default from './Default.astro'
import ActivityBar from '../components/vscode/ActivityBar.vue'
import Sidebar from '../components/vscode/Sidebar.vue'
import TabBar from '../components/vscode/TabBar.vue'
import BottomPanel from '../components/vscode/BottomPanel.vue'
import StatusBar from '../components/vscode/StatusBar.vue'
import SearchOverlay from '../components/vscode/SearchOverlay.vue'
import Footer from '../components/Footer.vue'

export interface Props {
  title: string
  description?: string
  image?: string
  type?: 'website' | 'article' | 'profile'
  lang?: 'en' | 'id'
}

const { title, description, image, type, lang } = Astro.props

// Line numbers are generated client-side based on actual content height
---

<Default title={title} description={description} image={image} type={type} lang={lang}>
  <slot slot="head" name="head" />
  <div
    id="vscode-window"
    class="fixed inset-0 flex flex-col isolate"
    style="background: var(--color-vscode-window);"
  >
    <!-- Workspace bar -->
    <div
      class="flex items-center px-3 flex-shrink-0 relative"
      style="height: 28px; background: var(--color-vscode-workspace); border-bottom: 1px solid rgba(255,255,255,0.06);"
    >
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div
          class="flex items-center gap-1.5 px-2 h-[18px] text-[11px] font-mono text-white/80"
          style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.14); border-radius: 2px;"
        >
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" style="color: #F5A100; flex-shrink: 0;">
            <path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
          </svg>
          <span>SE Laboratory</span>
        </div>
      </div>
      <a
        href="https://github.com/se-polinema"
        target="_blank"
        rel="noopener"
        class="flex items-center gap-1 text-[11px] font-mono text-white/55 hover:text-white/85 transition-colors ml-auto"
      >
        <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        se-polinema
      </a>
    </div>

    <div class="flex flex-1 overflow-hidden min-h-0">
      <ActivityBar client:load />
      <Sidebar client:load />

      <div class="relative z-0 flex flex-col flex-1 overflow-hidden min-w-0">
        <TabBar client:load />

        <!--
          Editor area — rendered like a WYSIWYG markdown buffer (render-markdown.nvim style).
          The gutter + content share the same scroll container so numbers scroll with text.
          The gutter is absolutely positioned inside .editor-wrap, which is driven by content height,
          so the gutter never makes the page taller than the content itself.
        -->
        <main id="editor" class="flex-1 overflow-y-auto bg-white dark:bg-gray-900">
          <div class="editor-wrap">
            <!-- Line-number gutter -->
            <div class="editor-gutter" id="editor-gutter" aria-hidden="true">
            </div>
            <!-- Page content -->
            <div class="editor-body">
              <slot />
              <Footer client:load />
            </div>
          </div>
        </main>

        <BottomPanel client:load />
      </div>
    </div>

    <StatusBar client:only="vue" />
    <SearchOverlay client:load />
  </div>

  <script>
    (function () {
      const LINE_HEIGHT = 22
      const MAX_LINES = 5000

      function generateLineNumbers() {
        const gutter = document.getElementById('editor-gutter')
        const editor = document.getElementById('editor')
        if (!gutter || !editor) return

        const needed = Math.min(
          Math.ceil(editor.scrollHeight / LINE_HEIGHT),
          MAX_LINES
        )

        const currentCount = gutter.children.length
        if (needed === currentCount) return

        gutter.innerHTML = ''

        const fragment = document.createDocumentFragment()
        for (let i = 1; i <= needed; i++) {
          const span = document.createElement('span')
          span.textContent = String(i)
          fragment.appendChild(span)
        }
        gutter.appendChild(fragment)
      }

      window.addEventListener('load', generateLineNumbers)

      const observer = new ResizeObserver(() => {
        generateLineNumbers()
      })

      const editor = document.getElementById('editor')
      if (editor) {
        observer.observe(editor)
      }
    })()
  </script>
</Default>

<style is:global>
/* ─── Editor layout ─── */
.editor-wrap {
  position: relative;
  min-height: 100%;
  display: flex;
}

.editor-gutter {
  flex-shrink: 0;
  width: 52px;
  height: 100%;
  overflow: hidden;          /* clips excess line numbers below content */
  background: var(--color-vscode-gutter-bg);
  border-right: 1px solid var(--color-vscode-gutter-border);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding: 0 10px 0 0;
  box-sizing: border-box;
  padding-top: 1px;
}

.editor-gutter span {
  display: block;
  height: 22px;
  line-height: 22px;
  font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  font-size: 11px;
  color: var(--color-vscode-gutter-text);
  user-select: none;
  flex-shrink: 0;
}

/* Highlight every 10th line number */
.editor-gutter span:nth-child(10n) {
  color: var(--color-vscode-gutter-text-em);
}

.editor-body {
  flex: 1;
  min-width: 0;
}

/* ─── Heading hash prefixes (WYSIWYG markdown style) ─── */
.editor-body h1:not([class]),
.editor-body h2:not([class]),
.editor-body h3:not([class]),
.editor-body h4:not([class]) {
  position: relative;
  font-family: 'DM Serif Display', 'Georgia', ui-serif, serif;
}

.editor-body h1:not([class])::before { content: '# '; }
.editor-body h2:not([class])::before { content: '## '; }
.editor-body h3:not([class])::before { content: '### '; }
.editor-body h4:not([class])::before { content: '#### '; }

.editor-body h1:not([class])::before,
.editor-body h2:not([class])::before,
.editor-body h3:not([class])::before,
.editor-body h4:not([class])::before {
  font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  font-weight: 400;
  color: var(--color-editor-hash);
  font-size: 0.85em;
  letter-spacing: -0.02em;
}

/* ─── Heading size & color hierarchy ─── */
.editor-body h1:not([class]) {
  font-size: 2.5rem;
  font-weight: 700;
  line-height: 1.15;
  color: var(--color-primary);
  margin-top: 0;
  margin-bottom: 0.25rem;
}

.editor-body h2:not([class]) {
  font-size: 1.375rem;
  font-weight: 600;
  line-height: 1.35;
  color: var(--color-primary);
  margin-top: 1.75rem;
  margin-bottom: 0.4rem;
}

.editor-body h3:not([class]) {
  font-size: 1.125rem;
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-primary);
  margin-top: 1.25rem;
  margin-bottom: 0.25rem;
}

.editor-body h4:not([class]) {
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-primary);
}

/* ─── Code blocks — editor-style dark background ─── */
.editor-body pre:not([class]),
.editor-body pre[class^="astro"]:not(.astro-code),
.editor-body .prose pre:not(.astro-code) {
  background: var(--color-editor-code-bg) !important;
  color: #D4D4D4;
  border-radius: 4px;
  padding: 1em 1.25em;
  font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  font-size: 12.5px;
  line-height: 1.65;
  overflow-x: auto;
  margin: 1em 0;
  border: 1px solid rgba(255,255,255,0.06);
}

/* Shiki code blocks — let their native background (#1E1E1E) show through */
.editor-body pre.astro-code,
.editor-body .prose pre.astro-code {
  border-radius: 4px;
  padding: 1em 1.25em;
  font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  font-size: 12.5px;
  line-height: 1.65;
  overflow-x: auto;
  margin: 1em 0;
  border: 1px solid rgba(255,255,255,0.06);
}

.editor-body code:not(pre code):not([class]),
.editor-body .prose :not(pre) > code {
  background: var(--color-editor-inline-code-bg);
  color: var(--color-editor-inline-code-text);
  font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
  font-size: 0.875em;
  padding: 0.15em 0.4em;
  border-radius: 3px;
  border: 1px solid var(--color-editor-inline-code-border);
}

/* ─── Blockquote — callout style ─── */
.editor-body blockquote:not([class]),
.editor-body .prose blockquote {
  border-left: 3px solid var(--color-editor-blockquote-border);
  background: var(--color-editor-blockquote-bg);
  padding: 0.5em 1em;
  margin: 1em 0;
  border-radius: 0 4px 4px 0;
  color: inherit;
  font-style: normal;
}

/* ─── Section dividers on home page ─── */
#editor section[id]:not(:first-child) {
  border-top: 1px solid var(--color-editor-section-divider);
}
</style>
