---
import { REPO_EDIT_BASE_URL } from '../lib/site'

export interface Props {
  filePath: string
}

const { filePath } = Astro.props
const editUrl = REPO_EDIT_BASE_URL + filePath
---

<div class="mt-12 pt-4 border-t border-primary/5 dark:border-gray-700">
  <a
    href={editUrl}
    target="_blank"
    rel="noopener"
    aria-label="Edit this page on GitHub"
    class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-400 dark:text-gray-500 hover:text-primary dark:hover:text-accent transition-colors"
  >
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M17 3a2.828 2.828 0 114 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
    </svg>
    <span lang="en">Edit this page on GitHub</span>
    <span lang="id">Edit halaman ini di GitHub</span>
  </a>
</div>
