---
import VSCodeLayout from '../layouts/VSCodeLayout.astro'
import ToolsPage from '../components/ToolsPage.vue'
import EditOnGitHub from '../components/EditOnGitHub.astro'
import toolsData from '../data/tools.json'
import researchData from '../data/research.json'
import { getCollection } from 'astro:content'
import type { Tool } from '../types/tool'

const tools = toolsData as Tool[]

const streams = researchData.map((s: { id: string; name: { en: string; id: string } }) => ({
  id: s.id,
  nameEn: s.name.en,
  nameId: s.name.id,
}))

const researchers = await getCollection('researchers')
const researcherNames: Record<string, string> = {}
for (const r of researchers) {
  researcherNames[r.id] = r.data.name
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'itemListElement': tools.map((t, i) => {
    const isDataset = t.type === 'dataset'
    const item: Record<string, unknown> = {
      '@type': isDataset ? 'Dataset' : 'SoftwareApplication',
      'name': t.title,
      'description': t.description,
      'applicationCategory': t.type,
      'operatingSystem': 'Any',
    }
    if (t.repoUrl) {
      if (isDataset) {
        item['url'] = t.repoUrl
      } else {
        item['downloadUrl'] = t.repoUrl
      }
    }
    if (t.license) {
      item['license'] = t.license
    }
    if (t.publicationSlug) {
      item['citation'] = `https://se.polinema.ac.id/publications/${t.publicationSlug}`
    }

    return {
      '@type': 'ListItem',
      'position': i + 1,
      'item': item,
    }
  }),
}
---

<VSCodeLayout title="Research Software & Tools — SE Lab" description="Lab-developed reusable research artifacts — software tools, frameworks, libraries, datasets, and prototypes produced by SE Lab researchers.">
  <ToolsPage client:load tools={tools} streams={streams} researcherNames={researcherNames} />
  <div class="px-8">
    <EditOnGitHub filePath="src/pages/tools.astro" />
  </div>
</VSCodeLayout>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
