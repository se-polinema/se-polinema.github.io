---
import Default from '../layouts/Default.astro'
import ActivityBar from '../components/vscode/ActivityBar.vue'
import Sidebar from '../components/vscode/Sidebar.vue'
import TabBar from '../components/vscode/TabBar.vue'
import StatusBar from '../components/vscode/StatusBar.vue'
import MobileTopBar from '../components/vscode/MobileTopBar.vue'
import Hero from '../components/Hero.vue'
import About from '../components/About.vue'
import Research from '../components/Research.vue'
import Team from '../components/Team.vue'
import News from '../components/News.vue'
import Publications from '../components/Publications.vue'
import Contact from '../components/Contact.vue'
import { getCollection } from 'astro:content'

const posts = await getCollection('blog', ({ data }) => data.lang === 'en' || data.lang === 'id')
const sortedPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    titleId: post.data.titleId,
    date: post.data.date,
    category: post.data.category,
    excerpt: post.data.excerpt,
    excerptId: post.data.excerptId,
  }))

const featuredResearchers = (await getCollection('researchers'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((researcher) => researcher.data.featured)
  .slice(0, 6)
  .map((researcher) => ({
    id: researcher.id,
    name: researcher.data.name,
    photo: researcher.data.photo,
    photoPosition: researcher.data.photoPosition,
    title: researcher.data.title,
    shortBio: researcher.data.shortBio,
    expertise: researcher.data.expertise,
  }))

const featuredPublications = (await getCollection('publications'))
  .sort((a, b) => b.data.year - a.data.year)
  .filter((publication) => publication.data.featured)
  .slice(0, 6)
  .map((publication) => ({
    id: publication.id,
    title: publication.data.title,
    year: publication.data.year,
    authors: publication.data.authors,
    venue: publication.data.venue,
    type: publication.data.type,
    url: publication.data.url,
  }))
---

<Default title="Software Engineering Laboratory">
  <div
    id="vscode-window"
    class="fixed inset-0 flex flex-col"
    style="background: #002D6B;"
  >
    <!-- Mobile top bar (hidden on desktop) -->
    <MobileTopBar client:load />

    <!-- Middle: activity bar + sidebar + editor -->
    <div class="flex flex-1 overflow-hidden min-h-0">
      <ActivityBar client:load />
      <Sidebar client:load />

      <!-- Editor column -->
      <div class="flex flex-col flex-1 overflow-hidden min-w-0">
        <TabBar client:load />

        <!-- Scrollable editor area -->
        <main id="editor" class="flex-1 overflow-y-auto bg-white">
          <Hero client:load />
          <About client:load />
          <Research client:load />
          <Team client:load researchers={featuredResearchers} />
          <Publications client:load publications={featuredPublications} />
          <News client:load posts={sortedPosts} />
          <Contact client:load />
        </main>
      </div>
    </div>

    <!-- Status bar -->
    <StatusBar client:load />
  </div>
</Default>
