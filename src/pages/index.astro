---
import VSCodeLayout from '../layouts/VSCodeLayout.astro'
import Hero from '../components/Hero.vue'
import About from '../components/About.vue'
import Research from '../components/Research.vue'
import Projects from '../components/Projects.vue'
import Books from '../components/Books.vue'
import Team from '../components/Team.vue'
import Publications from '../components/Publications.vue'
import JoinLab from '../components/JoinLab.vue'
import Achievements from '../components/Achievements.vue'
import News from '../components/News.vue'
import JsonLd from '../components/JsonLd.astro'
import EditOnGitHub from '../components/EditOnGitHub.astro'
import { getCollection } from 'astro:content'
import { getMemberProjects, getMemberBooks, getCollectionProjects } from '../lib/memberWorks'
import { existsSync } from 'node:fs'
import { resolve } from 'node:path'
import achievementsData from '../data/achievements.json'
import type { Achievement } from '../types/achievement'

const posts = await getCollection('blog', ({ data }) => data.lang === 'en' || data.lang === 'id')
const sortedPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    titleId: post.data.titleId,
    date: post.data.date,
    category: post.data.category,
    excerpt: post.data.excerpt,
    excerptId: post.data.excerptId,
  }))

const featuredResearchers = (await getCollection('researchers'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .filter((researcher) => researcher.data.featured)
  .slice(0, 6)
  .map((researcher) => ({
    id: researcher.id,
    name: researcher.data.name,
    photo: researcher.data.photo,
    photoPosition: researcher.data.photoPosition,
    title: researcher.data.title,
    shortBio: researcher.data.shortBio,
    expertise: researcher.data.expertise,
  }))

const featuredPublications = (await getCollection('publications'))
  .sort((a, b) => b.data.year - a.data.year)
  .filter((publication) => publication.data.featured)
  .slice(0, 6)
  .map((publication) => ({
    id: publication.id,
    title: publication.data.title,
    year: publication.data.year,
    authors: publication.data.authors,
    venue: publication.data.venue,
    type: publication.data.type,
    url: publication.data.url,
  }))

const collectionProjects = await getCollectionProjects()
const memberProjects = await getMemberProjects()

const collectionRepos = new Set(collectionProjects.map((p) => p.repo))
const legacyProjects = memberProjects.filter((p) => !collectionRepos.has(p.repo))

const projects = [...collectionProjects, ...legacyProjects]
const books = await getMemberBooks()

const origin = Astro.site?.origin ?? 'https://se-polinema.github.io'

const recentAchievements = (achievementsData as Achievement[])
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 5)
  .map((item) => ({
    title: item.title,
    titleId: item.titleId,
    date: item.date,
    type: item.type,
    description: item.description,
    descriptionId: item.descriptionId,
    url: item.url,
    issuer: item.issuer,
    members: item.members,
  }))

let logoUrl = new URL('/og-default.svg', origin).href
const logoPath = resolve('public/og-default.svg')
if (existsSync(logoPath)) {
  logoUrl = new URL('/og-default.svg', origin).href
}

const allResearchers = await getCollection('researchers')
const googleScholarUrls = allResearchers
  .map((r) => r.data.googleScholarUrl?.toString())
  .filter((url): url is string => url != null)

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Software Engineering Laboratory',
  alternateName: 'SE Lab',
  url: origin,
  logo: logoUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jl. Soekarno Hatta No. 9',
    addressLocality: 'Malang',
    addressRegion: 'Jawa Timur',
    postalCode: '65141',
    addressCountry: 'ID',
  },
  parentOrganization: {
    '@type': 'Organization',
    name: 'Politeknik Negeri Malang',
    url: 'https://www.polinema.ac.id',
  },
  sameAs: [
    'https://github.com/se-polinema',
    ...googleScholarUrls,
  ],
}
---

<VSCodeLayout title="Software Engineering Laboratory">
  <JsonLd slot="head" data={organizationJsonLd} />
  <Hero client:load />
  <About client:load />
  <Research client:load />
  <Projects client:load projects={projects} />
  <Books client:load books={books} />
  <Team client:load researchers={featuredResearchers} />
  <Publications client:load publications={featuredPublications} />
  <JoinLab client:load />
  <Achievements client:load achievements={recentAchievements} />
  <News client:load posts={sortedPosts} />
  <div class="px-8">
    <EditOnGitHub filePath="src/pages/index.astro" />
  </div>
</VSCodeLayout>
