---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import ResearcherProfilePage from '../../components/ResearcherProfilePage.vue'
import JsonLd from '../../components/JsonLd.astro'
import { getCollection } from 'astro:content'
import { existsSync, readFileSync } from 'node:fs'
import { resolve } from 'node:path'

export async function getStaticPaths() {
  const researchers = await getCollection('researchers')
  return researchers.map((researcher) => ({
    params: { id: researcher.id },
    props: { researcher },
  }))
}

const { researcher } = Astro.props

const publications = (await getCollection('publications', ({ data }) =>
  data.researchers.includes(researcher.id),
)).sort((a, b) => b.data.year - a.data.year)
  .map((publication) => ({
    id: publication.id,
    title: publication.data.title,
    year: publication.data.year,
    authors: publication.data.authors,
    venue: publication.data.venue,
    type: publication.data.type,
    url: publication.data.url,
    citedByCount: publication.data.citedByCount ?? 0,
  }))

let scholarMetrics = null
const metricsPath = resolve('src/data/_scholar-metrics.json')
if (existsSync(metricsPath)) {
  try {
    const metricsData = JSON.parse(readFileSync(metricsPath, 'utf-8'))
    const researcherMetrics = metricsData.researcherMetrics?.find(
      (m: { researcher: string }) => m.researcher === researcher.id,
    )
    if (researcherMetrics && !researcherMetrics._error) {
      scholarMetrics = {
        hindex: researcherMetrics.hindex ?? 0,
        i10index: researcherMetrics.i10index ?? 0,
        citedby: researcherMetrics.citedby ?? 0,
        citedby5y: researcherMetrics.citedby5y ?? 0,
      }
    }
  } catch {
    scholarMetrics = null
  }
}

const researcherProfile = {
  name: researcher.data.name,
  photo: researcher.data.photo,
  photoPosition: researcher.data.photoPosition,
  title: researcher.data.title,
  shortBio: researcher.data.shortBio,
  profileBody: researcher.data.profileBody,
  expertise: researcher.data.expertise,
  researchInterests: researcher.data.researchInterests,
  email: researcher.data.email,
  googleScholarUrl: researcher.data.googleScholarUrl,
  institutionalUrl: researcher.data.institutionalUrl,
  orcidUrl: researcher.data.orcidUrl,
  scopusUrl: researcher.data.scopusUrl,
  projects: researcher.data.projects,
  books: researcher.data.books,
  streams: researcher.data.streams,
  scholarMetrics,
}

const origin = Astro.site?.origin ?? 'https://se-polinema.github.io'
const profileUrl = new URL(Astro.url.pathname, origin).href
const photoUrl = researcher.data.photo.startsWith('http')
  ? researcher.data.photo
  : new URL(researcher.data.photo, origin).href

const sameAsUrls: string[] = []
if (researcher.data.googleScholarUrl) sameAsUrls.push(researcher.data.googleScholarUrl.toString())
if (researcher.data.orcidUrl) sameAsUrls.push(researcher.data.orcidUrl.toString())
if (researcher.data.scopusUrl) sameAsUrls.push(researcher.data.scopusUrl.toString())
if (researcher.data.institutionalUrl) sameAsUrls.push(researcher.data.institutionalUrl.toString())

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: researcher.data.name,
  jobTitle: researcher.data.title.en,
  image: photoUrl,
  email: researcher.data.email,
  url: profileUrl,
  sameAs: sameAsUrls.length > 0 ? sameAsUrls : undefined,
  knowsAbout: [
    ...researcher.data.expertise,
    ...researcher.data.researchInterests.en,
    ...researcher.data.researchInterests.id,
  ],
  affiliation: {
    '@type': 'Organization',
    name: 'Software Engineering Laboratory',
    url: origin,
    parentOrganization: {
      '@type': 'Organization',
      name: 'Politeknik Negeri Malang',
      url: 'https://www.polinema.ac.id',
    },
  },
}
---

<VSCodeLayout
  title={researcher.data.name}
  type="profile"
  image={researcher.data.photo}
>
  <JsonLd slot="head" data={personJsonLd} />
  <ResearcherProfilePage client:load researcher={researcherProfile} publications={publications} />
</VSCodeLayout>
