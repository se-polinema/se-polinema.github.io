---
// Sign-in and sign-up are the same action now that login is GitHub-only
// (OAuth creates the account on first use); there's no separate "create
// account" step anymore. Redirect to /login, preserving any ?redirect=
// param: astro.config.mjs's static `redirects` option only maps to a
// fixed target path, so it can't forward an incoming query string.
// This small client-side redirect can.
import VSCodeLayout from '../layouts/VSCodeLayout.astro'
import { withBase } from '../lib/paths'
---

<VSCodeLayout
  title="Redirecting…"
  description="Sign in to your Software Engineering Laboratory account."
>
  <div class="px-8 py-5">
    <p class="text-sm font-mono text-neutral-500 dark:text-gray-400">
      Redirecting to <a href={withBase('/login')} class="text-accent hover:text-accent/80 transition-colors">sign in</a>…
    </p>
  </div>
  <script>
    import { withBase } from '../lib/paths'
    window.location.replace(withBase('/login') + window.location.search)
  </script>
</VSCodeLayout>
