---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import JsonLd from '../../components/JsonLd.astro'
import { getCollection } from 'astro:content'
import researchData from '../../data/research.json'

export function getStaticPaths() {
  return researchData.map((stream) => ({
    params: { streamId: stream.id },
    props: { stream },
  }))
}

interface Stream {
  id: string
  name: { en: string; id: string }
  tagline: { en: string; id: string }
  topics: string[]
}

const { stream } = Astro.props as { stream: Stream }

const allResearchers = await getCollection('researchers')
const streamResearchers = allResearchers
  .filter((r) => r.data.streams?.includes(stream.id))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))

const researcherIds = streamResearchers.map((r) => r.id)

const streamPublications = researcherIds.length > 0
  ? (await getCollection('publications', ({ data }) =>
      data.researchers.some((rid: string) => researcherIds.includes(rid)),
    )).sort((a, b) => b.data.year - a.data.year)
  : []

const collectionStreamProjects = (await getCollection('projects', ({ data }) => data.stream === stream.id)).map((p) => ({
    name: p.data.title,
    nameId: p.data.titleId,
    repo: p.data.repo,
    description: p.data.description,
    descriptionId: p.data.descriptionId,
    researcherId: p.data.researchers[0] ?? 'unknown',
    researcherName: streamResearchers.find((r) => r.id === p.data.researchers[0])?.data.name ?? 'SE Lab',
    slug: p.id,
  }))

const collectionReposForStream = new Set(collectionStreamProjects.map((p) => p.repo))

const researcherProjects = streamResearchers.flatMap((r) =>
    (r.data.projects ?? [])
      .filter((p) => !collectionReposForStream.has(p.repo))
      .map((p) => ({
        name: p.name,
        nameId: p.nameId,
        repo: p.repo,
        description: p.description,
        descriptionId: p.descriptionId,
        researcherId: r.id,
        researcherName: r.data.name,
      })),
  )

const streamProjects = [...collectionStreamProjects, ...researcherProjects]
    .sort((a, b) => a.researcherName.localeCompare(b.researcherName))

const origin = Astro.site?.origin ?? 'https://se.polinema.ac.id'
const pageUrl = new URL(Astro.url.pathname, origin).href

const researchProjectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ResearchProject',
  name: stream.name.en,
  alternateName: stream.name.id,
  description: stream.tagline.en,
  url: pageUrl,
  keywords: stream.topics.join(', '),
  ...(streamResearchers.length > 0 ? {
    member: streamResearchers.map((r) => ({
      '@type': 'Person',
      name: r.data.name,
      url: new URL(`/researchers/${r.id}`, origin).href,
    })),
  } : {}),
}
---

<VSCodeLayout title={stream.name.en} type="article">
  <JsonLd slot="head" data={researchProjectJsonLd} />
  <div class="px-8 py-8 max-w-4xl bilingual-post">
    <a
      href="/"
      class="inline-flex items-center gap-1 text-xs font-mono text-neutral-400 dark:text-gray-500 hover:text-primary dark:hover:text-accent transition-colors mb-8"
    >
      <span lang="en">&larr; Back to Home</span>
      <span lang="id">&larr; Kembali ke Beranda</span>
    </a>

    <h1 lang="en">{stream.name.en}</h1>
    <h1 lang="id">{stream.name.id}</h1>

    <p lang="en" class="text-lg text-neutral-600 dark:text-gray-300 leading-relaxed mb-6 mt-2">
      {stream.tagline.en}
    </p>
    <p lang="id" class="text-lg text-neutral-600 dark:text-gray-300 leading-relaxed mb-6 mt-2">
      {stream.tagline.id}
    </p>

    <h2 lang="en">Topics</h2>
    <h2 lang="id">Topik</h2>
    <div class="flex flex-wrap gap-2 mb-10">
      {stream.topics.map((topic) => (
        <span class="inline-block text-xs font-mono px-2.5 py-1 rounded bg-primary/[0.06] dark:bg-gray-800 text-primary/70 dark:text-gray-300 border border-primary/10 dark:border-gray-700">
          {topic}
        </span>
      ))}
    </div>

    <h2 lang="en">Researchers</h2>
    <h2 lang="id">Peneliti</h2>
    {
      streamResearchers.length > 0 ? (
        <div class="grid sm:grid-cols-2 gap-3 mb-10">
          {streamResearchers.map((r) => (
            <a href={`/researchers/${r.id}`} class="stream-hub-researcher-card">
              <div class="flex items-start gap-4">
                <img
                  src={r.data.photo}
                  alt={r.data.name}
                  class="w-14 h-14 rounded-full object-cover shrink-0 border-2 border-white dark:border-gray-700 shadow-sm"
                  style={r.data.photoPosition ? { objectPosition: r.data.photoPosition } : undefined}
                />
                <div class="min-w-0">
                  <h3 class="font-serif text-base font-semibold text-primary dark:text-gray-100 group-hover:text-accent dark:group-hover:text-accent transition-colors leading-snug">
                    {r.data.name}
                  </h3>
                  <p class="text-xs text-neutral-500 dark:text-gray-400 mt-0.5 line-clamp-2">
                    <span lang="en">{r.data.shortBio.en}</span>
                    <span lang="id">{r.data.shortBio.id}</span>
                  </p>
                  {r.data.expertise.length > 0 && (
                    <div class="flex flex-wrap gap-1 mt-2">
                      {r.data.expertise.slice(0, 3).map((exp) => (
                        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-gray-700 text-neutral-500 dark:text-gray-400">
                          {exp}
                        </span>
                      ))}
                      {r.data.expertise.length > 3 && (
                        <span class="text-[10px] font-mono text-neutral-400">+{r.data.expertise.length - 3}</span>
                      )}
                    </div>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="mb-10">
          <p lang="en" class="text-sm text-neutral-400 dark:text-gray-500 italic py-4 border border-dashed border-neutral-200 dark:border-gray-700 px-4 text-center">
            No researchers are currently associated with this stream.
          </p>
          <p lang="id" class="text-sm text-neutral-400 dark:text-gray-500 italic py-4 border border-dashed border-neutral-200 dark:border-gray-700 px-4 text-center">
            Belum ada peneliti yang terkait dengan stream ini.
          </p>
        </div>
      )
    }

    <h2 lang="en">Projects</h2>
    <h2 lang="id">Proyek</h2>
    {
      streamProjects.length > 0 ? (
        <div class="grid sm:grid-cols-2 gap-3 mb-10">
          {streamProjects.map((p: any) => (
            <a
              href={p.slug ? `/projects/${p.slug}` : `https://github.com/${p.repo}`}
              target={p.slug ? undefined : '_blank'}
              rel={p.slug ? undefined : 'noopener'}
              class="stream-hub-researcher-card"
            >
              <div class="flex items-center gap-3 mb-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-primary/60 shrink-0">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span class="font-mono text-sm font-medium text-primary dark:text-gray-200 truncate">{p.repo}</span>
              </div>
              <h4 class="font-semibold text-sm text-primary dark:text-gray-100 mb-1">
                {p.name}
              </h4>
              {p.description && (
                <p lang="en" class="text-xs text-neutral-500 dark:text-gray-400 line-clamp-2">
                  {p.description}
                </p>
              )}
              {p.descriptionId && (
                <p lang="id" class="text-xs text-neutral-500 dark:text-gray-400 line-clamp-2">
                  {p.descriptionId}
                </p>
              )}
              <p class="text-[10px] font-mono text-neutral-400 dark:text-gray-500 mt-2">
                <span lang="en">by {p.researcherName}</span>
                <span lang="id">oleh {p.researcherName}</span>
              </p>
            </a>
          ))}
        </div>
      ) : (
        <div class="mb-10">
          <p lang="en" class="text-sm text-neutral-400 dark:text-gray-500 italic py-4 border border-dashed border-neutral-200 dark:border-gray-700 px-4 text-center">
            No projects are currently associated with this stream.
          </p>
          <p lang="id" class="text-sm text-neutral-400 dark:text-gray-500 italic py-4 border border-dashed border-neutral-200 dark:border-gray-700 px-4 text-center">
            Belum ada proyek yang terkait dengan stream ini.
          </p>
        </div>
      )
    }

    <h2 lang="en">Publications</h2>
    <h2 lang="id">Publikasi</h2>
    {
      streamPublications.length > 0 ? (
        <div class="mb-10">
          {streamPublications.slice(0, 20).map((pub) => (
            <a
              href={pub.data.url.toString()}
              target="_blank"
              rel="noopener"
              class="stream-hub-pub-item"
            >
              <div class="flex flex-wrap items-start gap-x-3 gap-y-1">
                <span class="text-xs font-mono font-medium px-1.5 py-0.5 rounded bg-accent/10 dark:bg-accent/20 text-accent dark:text-accent shrink-0">
                  {pub.data.year}
                </span>
                <span class="text-xs font-mono px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-gray-700 text-neutral-500 dark:text-gray-400 shrink-0 capitalize">
                  {pub.data.type}
                </span>
                <h4 class="text-sm font-medium text-primary dark:text-gray-200 leading-snug flex-1 min-w-0">
                  {pub.data.title}
                </h4>
              </div>
              <div class="mt-1 ml-0">
                <span class="text-xs text-neutral-400 dark:text-gray-500">{pub.data.venue}</span>
                {pub.data.authors.length > 0 && (
                  <span class="text-xs text-neutral-400 dark:text-gray-500"> &middot; {pub.data.authors.join(', ')}</span>
                )}
              </div>
            </a>
          ))}
          {streamPublications.length > 20 && (
            <p class="text-xs text-neutral-400 dark:text-gray-500 mt-3 text-center">
              <span lang="en">Showing 20 of {streamPublications.length} publications.</span>
              <span lang="id">Menampilkan 20 dari {streamPublications.length} publikasi.</span>
            </p>
          )}
        </div>
      ) : (
        <div class="mb-10">
          <p lang="en" class="text-sm text-neutral-400 dark:text-gray-500 italic py-4 border border-dashed border-neutral-200 dark:border-gray-700 px-4 text-center">
            No publications are currently associated with this stream.
          </p>
          <p lang="id" class="text-sm text-neutral-400 dark:text-gray-500 italic py-4 border border-dashed border-neutral-200 dark:border-gray-700 px-4 text-center">
            Belum ada publikasi yang terkait dengan stream ini.
          </p>
        </div>
      )
    }
  </div>
</VSCodeLayout>
