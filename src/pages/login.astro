---
import VSCodeLayout from '../layouts/VSCodeLayout.astro'
import AuthForm from '../components/AuthForm.vue'
---

<VSCodeLayout
  title="Sign In"
  description="Sign in to your Software Engineering Laboratory account."
>
  <div class="px-8 py-5">
    <a
      href="/events"
      class="inline-flex items-center gap-1 text-xs font-mono text-primary/40 dark:text-gray-500 hover:text-primary dark:hover:text-gray-100 transition-colors mb-6"
    >
      &larr; Back to Events
    </a>
    <AuthForm client:load />
  </div>
</VSCodeLayout>
