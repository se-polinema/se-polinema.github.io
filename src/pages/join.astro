---
import VSCodeLayout from '../layouts/VSCodeLayout.astro'
import JoinPage from '../components/JoinPage.vue'
import EditOnGitHub from '../components/EditOnGitHub.astro'
import opportunitiesData from '../data/opportunities.json'
import researchData from '../data/research.json'
import { encodeEmail } from '../utils/email'

const streams = researchData.map((s: { id: string; name: { en: string; id: string } }) => ({
  id: s.id,
  nameEn: s.name.en,
  nameId: s.name.id,
}))

const opportunities = opportunitiesData.map(({ supervisorEmail, ...opp }) => ({
  ...opp,
  supervisorEmailEncoded: encodeEmail(supervisorEmail),
}))
---

<VSCodeLayout title="Join — SE Lab">
  <JoinPage client:load opportunities={opportunities} streams={streams} />
  <div class="px-8">
    <EditOnGitHub filePath="src/pages/join.astro" />
  </div>
</VSCodeLayout>
