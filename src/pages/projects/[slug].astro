---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import JsonLd from '../../components/JsonLd.astro'
import EditOnGitHub from '../../components/EditOnGitHub.astro'
import ProjectGallery from '../../components/ProjectGallery.vue'
import { getCollection, render } from 'astro:content'
import researchData from '../../data/research.json'
import { getResearcherAvatar, type ResearcherImage } from '../../lib/researcherImage'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)
const { title, titleId, description, descriptionId, status, techStack, images, contributors, researchers, stream, demoUrl, videoUrl, repo, private: isPrivate } = project.data

const allResearchers = await getCollection('researchers')
const teamResearchers = allResearchers
  .filter((r) => researchers.includes(r.id))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))

const teamResearcherImages = new Map<string, ResearcherImage | null>()
for (const r of teamResearchers) {
  teamResearcherImages.set(r.id, await getResearcherAvatar(r.id))
}

const streamData = stream ? researchData.find((s: { id: string }) => s.id === stream) : null
const streamName = streamData
  ? { en: (streamData as { name: { en: string; id: string } }).name.en, id: (streamData as { name: { en: string; id: string } }).name.id }
  : null

const origin = Astro.site?.origin ?? 'https://se.polinema.ac.id'
const pageUrl = new URL(Astro.url.pathname, origin).href

const placeholderImage = '/images/projects/placeholder.svg'

function getHeroImage(): string {
  if (images.length > 0) return images[0]
  if (demoUrl) return `https://image.thum.io/get/maxAge/12/width/1200/crop/800/${encodeURIComponent(demoUrl)}`
  return placeholderImage
}

const heroImage = getHeroImage()

const softwareSourceCodeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: title,
  ...(titleId ? { alternateName: titleId } : {}),
  description: description,
  url: pageUrl,
  codeRepository: `https://github.com/${repo}`,
  ...(demoUrl ? { installUrl: demoUrl } : {}),
  programmingLanguage: techStack.length > 0 ? techStack.join(', ') : undefined,
  ...(status === 'active' || status === 'under-development' ? { creativeWorkStatus: 'InProgress' } : status === 'completed' ? { creativeWorkStatus: 'Published' } : {}),
  author: teamResearchers.length > 0
    ? teamResearchers.map((r) => ({
        '@type': 'Person',
        name: r.data.name,
        url: new URL(`/researchers/${r.id}`, origin).href,
      }))
    : {
        '@type': 'Organization',
        name: 'Software Engineering Laboratory',
        url: origin,
      },
  publisher: {
    '@type': 'Organization',
    name: 'Software Engineering Laboratory',
    url: origin,
  },
}

const statusLabel = {
  en: { active: 'Active', completed: 'Completed', prototype: 'Prototype', 'under-development': 'Under Development' },
  id: { active: 'Aktif', completed: 'Selesai', prototype: 'Prototipe', 'under-development': 'Dalam Pengembangan' },
}
const statusColor = {
  active: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 border-green-200 dark:border-green-800',
  completed: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 border-blue-200 dark:border-blue-800',
  prototype: 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 border-amber-200 dark:border-amber-800',
  'under-development': 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300 border-purple-200 dark:border-purple-800',
}
---

<VSCodeLayout title={title} type="article" image={`/og/projects/${project.id}.png`}>
  <JsonLd slot="head" data={softwareSourceCodeJsonLd} />
  <div class="px-8 py-8 max-w-5xl bilingual-post">

    <!-- Back link -->
    <a
      href="/projects"
      class="inline-flex items-center gap-1 text-xs font-mono text-neutral-400 dark:text-gray-500 hover:text-primary dark:hover:text-accent transition-colors mb-8"
    >
      <span lang="en">&larr; Back to Projects</span>
      <span lang="id">&larr; Kembali ke Proyek</span>
    </a>

    <!-- Hero section: two columns (Kickstarter-style) -->
    <div class="grid lg:grid-cols-5 gap-8 mb-12">

      <!-- Left: Media gallery (images + video) -->
      <div class="lg:col-span-3 space-y-6">

        <!-- Image gallery -->
        {
          images.length > 0 ? (
            <ProjectGallery client:load images={images} placeholder={placeholderImage} alt={title} />
          ) : (
            <div class="border border-primary/10 dark:border-gray-700 rounded-xl overflow-hidden bg-neutral-100 dark:bg-gray-800 aspect-video">
              <img
                src={heroImage}
                alt={title}
                class="w-full h-full object-cover"
                loading="lazy"
                onerror={"this.onerror=null;this.src='" + placeholderImage + "'"}
              />
            </div>
          )
        }

        <!-- Promotional Video -->
        {videoUrl && (
          <div class="border border-primary/10 dark:border-gray-700 rounded-xl overflow-hidden bg-white dark:bg-gray-800">
            <div class="px-4 py-3 border-b border-primary/5 dark:border-gray-700">
              <span lang="en" class="text-sm font-mono text-primary/70 dark:text-gray-300">Promotional Video</span>
              <span lang="id" class="text-sm font-mono text-primary/70 dark:text-gray-300">Video Promosi</span>
            </div>
            <div class="aspect-video">
              <iframe
                src={videoUrl}
                title={title}
                class="w-full h-full"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              />
            </div>
          </div>
        )}
      </div>

      <!-- Right: Sticky sidebar -->
      <div class="lg:col-span-2">
        <div class="lg:sticky lg:top-24 space-y-6">

          <!-- Title + Status -->
          <div>
            <div class="flex flex-wrap items-center gap-3 mb-2">
              <h1 lang="en" class="font-serif text-2xl md:text-3xl font-bold text-primary dark:text-gray-100 leading-tight">{title}</h1>
              <h1 lang="id" class="font-serif text-2xl md:text-3xl font-bold text-primary dark:text-gray-100 leading-tight">{titleId ?? title}</h1>
            </div>
            <span class={`inline-block text-xs font-mono px-2.5 py-0.5 rounded border ${statusColor[status]}`}>
              <span lang="en">{statusLabel.en[status]}</span>
              <span lang="id">{statusLabel.id[status]}</span>
            </span>
          </div>

          <!-- Description / Pitch -->
          <div class="text-neutral-600 dark:text-gray-300 leading-relaxed text-sm">
            <p lang="en">{description}</p>
            <p lang="id">{descriptionId ?? description}</p>
          </div>

          <!-- Quick Stats -->
          <div class="border border-primary/10 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 divide-y divide-primary/5 dark:divide-gray-700">
            <div class="px-4 py-3">
              <div class="text-[10px] uppercase tracking-wider text-neutral-400 dark:text-gray-500 mb-1">
                <span lang="en">Status</span>
                <span lang="id">Status</span>
              </div>
              <span class={`inline-block text-xs font-mono px-2 py-0.5 rounded border ${statusColor[status]}`}>
                <span lang="en">{statusLabel.en[status]}</span>
                <span lang="id">{statusLabel.id[status]}</span>
              </span>
            </div>
            {
              streamName && (
                <div class="px-4 py-3">
                  <div class="text-[10px] uppercase tracking-wider text-neutral-400 dark:text-gray-500 mb-1">
                    <span lang="en">Research Stream</span>
                    <span lang="id">Stream Riset</span>
                  </div>
                  <a href={`/research/${stream}`} class="text-sm text-primary dark:text-blue-300 hover:text-accent-700 dark:hover:text-accent-400 transition-colors font-mono">
                    <span lang="en">{streamName.en}</span>
                    <span lang="id">{streamName.id}</span>
                  </a>
                </div>
              )
            }
            {
              techStack.length > 0 && (
                <div class="px-4 py-3">
                  <div class="text-[10px] uppercase tracking-wider text-neutral-400 dark:text-gray-500 mb-1.5">
                    <span lang="en">Tech Stack</span>
                    <span lang="id">Stack Teknologi</span>
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    {techStack.slice(0, 6).map((tech) => (
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-primary/[0.06] dark:bg-gray-700 text-primary/70 dark:text-gray-300 border border-primary/10 dark:border-gray-600">
                        {tech}
                      </span>
                    ))}
                    {techStack.length > 6 && (
                      <span class="text-[10px] font-mono text-neutral-400 dark:text-gray-500 self-center">+{techStack.length - 6}</span>
                    )}
                  </div>
                </div>
              )
            }
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col gap-2.5">
            <a
              href={`https://github.com/${repo}`}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-mono bg-primary text-white dark:bg-blue-600 dark:text-white hover:bg-primary/90 dark:hover:bg-blue-500 transition-colors rounded-lg"
            >
              {
                isPrivate ? (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"/>
                    <circle cx="12" cy="16" r="1"/>
                  </svg>
                ) : (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                )
              }
              {
                isPrivate ? (
                  <>
                    <span lang="en">Private Repository</span>
                    <span lang="id">Repositori Privat</span>
                  </>
                ) : (
                  <>
                    <span lang="en">View on GitHub</span>
                    <span lang="id">Lihat di GitHub</span>
                  </>
                )
              }
            </a>
            {demoUrl && (
              <a
                href={demoUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-mono border border-primary/20 dark:border-gray-600 text-primary dark:text-gray-200 hover:bg-primary/5 dark:hover:bg-gray-800 transition-colors rounded-lg"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
                <span lang="en">Live Demo</span>
                <span lang="id">Demo Langsung</span>
              </a>
            )}
          </div>

          <!-- Team avatars (compact) -->
          {
            teamResearchers.length > 0 && (
              <div>
                <div class="text-[10px] uppercase tracking-wider text-neutral-400 dark:text-gray-500 mb-2.5">
                  <span lang="en">Research Team</span>
                  <span lang="id">Tim Riset</span>
                </div>
                <div class="flex flex-wrap gap-2">
                  {teamResearchers.map((r) => (
                    <a href={`/researchers/${r.id}`} class="group flex items-center gap-2" title={r.data.name}>
                      <img
                        src={teamResearcherImages.get(r.id)?.src ?? r.data.photo}
                        srcset={teamResearcherImages.get(r.id)?.srcset}
                        sizes={teamResearcherImages.get(r.id)?.sizes}
                        width={teamResearcherImages.get(r.id)?.width}
                        height={teamResearcherImages.get(r.id)?.height}
                        alt={r.data.name}
                        class="w-8 h-8 rounded-full object-cover border border-primary/10 dark:border-gray-600 shrink-0"
                        style={r.data.photoPosition ? { objectPosition: r.data.photoPosition } : undefined}
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="text-xs text-neutral-500 dark:text-gray-400 group-hover:text-accent-700 dark:group-hover:text-accent-400 transition-colors truncate max-w-[140px]">{r.data.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>

    <!-- Body Content (full width below hero) -->
    <div class="prose prose-slate dark:prose-invert max-w-none bilingual-post mb-12">
      <Content />
    </div>

    <!-- Full Tech Stack -->
    {
      techStack.length > 0 && (
        <div class="mb-8">
          <h2 lang="en" class="font-serif text-xl font-bold text-primary dark:text-gray-100 mb-3">Tech Stack</h2>
          <h2 lang="id" class="font-serif text-xl font-bold text-primary dark:text-gray-100 mb-3">Stack Teknologi</h2>
          <div class="flex flex-wrap gap-2">
            {techStack.map((tech) => (
              <span class="inline-block text-xs font-mono px-2.5 py-1 rounded bg-primary/[0.06] dark:bg-gray-800 text-primary/70 dark:text-gray-300 border border-primary/10 dark:border-gray-700">
                {tech}
              </span>
            ))}
          </div>
        </div>
      )
    }

    <!-- Research Stream -->
    <div class="mb-8">
      <h2 lang="en" class="font-serif text-xl font-bold text-primary dark:text-gray-100 mb-3">Research Stream</h2>
      <h2 lang="id" class="font-serif text-xl font-bold text-primary dark:text-gray-100 mb-3">Stream Riset</h2>
      {streamName ? (
        <a
          href={`/research/${stream}`}
          class="inline-flex items-center gap-1 text-sm text-primary dark:text-blue-300 hover:text-accent-700 dark:hover:text-accent-400 transition-colors font-mono"
        >
          <span lang="en">{streamName.en}</span>
          <span lang="id">{streamName.id}</span>
          <span>&rarr;</span>
        </a>
      ) : (
        <p class="text-sm text-neutral-400 dark:text-gray-500 italic">
          <span lang="en">No stream assigned</span>
          <span lang="id">Tidak ada stream</span>
        </p>
      )}
    </div>

    <!-- Research Team (full cards) -->
    {
      teamResearchers.length > 0 && (
        <div class="mb-8">
          <h2 lang="en" class="font-serif text-xl font-bold text-primary dark:text-gray-100 mb-3">Research Team</h2>
          <h2 lang="id" class="font-serif text-xl font-bold text-primary dark:text-gray-100 mb-3">Tim Riset</h2>
          <div class="grid sm:grid-cols-2 gap-3">
            {teamResearchers.map((r) => (
              <a href={`/researchers/${r.id}`} class="stream-hub-researcher-card">
                <div class="flex items-start gap-4">
                  <img
                    src={teamResearcherImages.get(r.id)?.src ?? r.data.photo}
                    srcset={teamResearcherImages.get(r.id)?.srcset}
                    sizes={teamResearcherImages.get(r.id)?.sizes}
                    width={teamResearcherImages.get(r.id)?.width}
                    height={teamResearcherImages.get(r.id)?.height}
                    alt={r.data.name}
                    class="w-14 h-14 rounded-full object-cover shrink-0 border-2 border-white dark:border-gray-700 shadow-sm"
                    style={r.data.photoPosition ? { objectPosition: r.data.photoPosition } : undefined}
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="min-w-0">
                    <h3 class="font-serif text-base font-semibold text-primary dark:text-gray-100 group-hover:text-accent-700 dark:group-hover:text-accent-400 transition-colors leading-snug">
                      {r.data.name}
                    </h3>
                    <p class="text-xs text-neutral-500 dark:text-gray-400 mt-0.5 line-clamp-2">
                      <span lang="en">{r.data.shortBio.en}</span>
                      <span lang="id">{r.data.shortBio.id}</span>
                    </p>
                    {r.data.expertise.length > 0 && (
                      <div class="flex flex-wrap gap-1 mt-2">
                        {r.data.expertise.slice(0, 3).map((exp) => (
                          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-gray-700 text-neutral-500 dark:text-gray-400">
                            {exp}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- Contributors -->
    {
      contributors.length > 0 && (
        <div class="mb-8">
          <h2 lang="en" class="font-serif text-xl font-bold text-primary dark:text-gray-100 mb-3">Contributors</h2>
          <h2 lang="id" class="font-serif text-xl font-bold text-primary dark:text-gray-100 mb-3">Kontributor</h2>
          <ul class="space-y-1">
            {contributors.map((c) => (
              <li class="text-sm text-neutral-600 dark:text-gray-300">{c}</li>
            ))}
          </ul>
        </div>
      )
    }

    <EditOnGitHub filePath={`src/content/projects/${project.id}.md`} />
  </div>
</VSCodeLayout>
