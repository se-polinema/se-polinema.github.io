---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import PublicationsArchive from '../../components/PublicationsArchive.vue'
import PublicationsPageIntro from '../../components/PublicationsPageIntro.vue'
import { getCollection } from 'astro:content'
import { readFileSync, existsSync } from 'node:fs'
import { resolve } from 'node:path'

const publications = (await getCollection('publications'))
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title))
  .map((publication) => ({
    id: publication.id,
    title: publication.data.title,
    year: publication.data.year,
    authors: publication.data.authors,
    venue: publication.data.venue,
    type: publication.data.type,
    url: publication.data.url,
    researchers: publication.data.researchers,
  }))

const researchers = (await getCollection('researchers'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .map((researcher) => ({
    id: researcher.id,
    name: researcher.data.name,
  }))

let lastUpdated = null
const syncMetaPath = resolve('src/data/_sync-meta.json')
if (existsSync(syncMetaPath)) {
  try {
    const meta = JSON.parse(readFileSync(syncMetaPath, 'utf-8'))
    lastUpdated = meta.lastUpdated || null
  } catch {
    lastUpdated = null
  }
}
---

<VSCodeLayout title="Publications">
  <div class="px-8 py-5">
    <PublicationsPageIntro client:load lastUpdated={lastUpdated} />
    <div class="mb-10">
      <a
        href="/publications.xml"
        class="inline-flex items-center gap-2 text-sm font-medium text-primary dark:text-primary/80 hover:underline"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 11a9 9 0 019 9"/>
          <path d="M4 4a16 16 0 0116 16"/>
          <circle cx="5" cy="19" r="1"/>
        </svg>
        Subscribe to publications feed
      </a>
    </div>
    <PublicationsArchive client:load publications={publications} researchers={researchers} />
  </div>
</VSCodeLayout>
