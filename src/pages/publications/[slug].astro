---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import JsonLd from '../../components/JsonLd.astro'
import CitationExport from '../../components/CitationExport.vue'
import ShareButtons from '../../components/ShareButtons.vue'
import RelatedContent from '../../components/RelatedContent.vue'
import EditOnGitHub from '../../components/EditOnGitHub.astro'
import PageFeedback from '../../components/PageFeedback.vue'
import { getCollection } from 'astro:content'
import { getRelatedItems } from '../../utils/relatedContent'
import type { CurrentItem, CandidateItem } from '../../utils/relatedContent'
import type { RelatedContentItem } from '../../components/RelatedContent.vue'

export async function getStaticPaths() {
  const publications = await getCollection('publications')
  return publications.map((publication) => ({
    params: { slug: publication.id },
    props: { publication },
  }))
}

const { publication } = Astro.props
const { title, year, type, venue, authors, url, doi, googleScholarUrl, language } = publication.data

const origin = Astro.site?.origin ?? 'https://se.polinema.ac.id'
const pubUrl = new URL(Astro.url.pathname, origin).href

const scholarlyArticleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: title,
  author: authors.map((name: string) => ({
    '@type': 'Person',
    name,
  })),
  datePublished: String(year),
  publisher: {
    '@type': 'Organization',
    name: venue,
  },
  url: pubUrl,
  sameAs: url,
  ...(doi ? { identifier: { '@type': 'PropertyValue', propertyID: 'doi', value: doi } } : {}),
  inLanguage: language,
}

const currentPub: CurrentItem = {
  id: publication.id,
  title,
  authors,
  year,
  type,
  excerpt: venue,
}

const allPublications = await getCollection('publications')
const pubCandidates: CandidateItem[] = allPublications
  .filter((p) => p.id !== publication.id)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    authors: p.data.authors,
    year: p.data.year,
    type: p.data.type,
    excerpt: p.data.venue,
  }))

const researchers = await getCollection('researchers')
const researcherMap = new Map(researchers.map((r) => [r.data.name, r]))

const currentResearcherSlugs = publication.data.researchers ?? []

const projectCandidates: CandidateItem[] = (await getCollection('projects'))
  .filter((proj) =>
    proj.data.researchers.some((r) => currentResearcherSlugs.includes(r))
  )
  .map((p) => ({
    id: `project:${p.id}`,
    title: p.data.title,
    authors: p.data.researchers,
    excerpt: p.data.description,
  }))

const researcherCandidates: CandidateItem[] = researchers
  .filter((r) => currentResearcherSlugs.includes(r.id))
  .map((r) => ({
    id: `researcher:${r.id}`,
    title: r.data.name,
    authors: [r.data.name],
    excerpt: r.data.title?.en ?? '',
  }))

const allCandidates = [...pubCandidates, ...projectCandidates, ...researcherCandidates]
const scored = getRelatedItems(currentPub, allCandidates, 8)

const pubMap = new Map(allPublications.map((p) => [p.id, p]))
const projectMap = new Map((await getCollection('projects')).map((p) => [p.id, p]))

const relatedItems: RelatedContentItem[] = scored.map((item) => {
  if (item.id.startsWith('project:')) {
    const projectSlug = item.id.replace('project:', '')
    const proj = projectMap.get(projectSlug)
    return {
      id: item.id,
      title: proj?.data.title ?? item.title,
      titleId: proj?.data.titleId,
      description: proj?.data.description ?? item.excerpt,
      descriptionId: proj?.data.descriptionId,
      url: `/projects/${projectSlug}`,
      badge: 'Project',
      badgeClass: 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400',
      __source: 'project' as const,
    }
  }

  if (item.id.startsWith('researcher:')) {
    const researcherSlug = item.id.replace('researcher:', '')
    const res = researcherMap.get(item.title)
    return {
      id: item.id,
      title: item.title,
      titleId: undefined,
      description: item.excerpt,
      url: `/researchers/${researcherSlug}`,
      badge: 'Researcher',
      badgeClass: 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400',
      metaYear: undefined,
      metaVenue: res?.data.title?.en ?? item.excerpt,
      __source: 'researcher' as const,
    }
  }

  const pub = pubMap.get(item.id)
  const pubBadgeClass: Record<string, string> = {
    journal: 'bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary/80',
    conference: 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400',
    'book-chapter': 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400',
    proceeding: 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300',
    preprint: 'bg-teal-100 text-teal-700 dark:bg-teal-900/30 dark:text-teal-400',
  }

  return {
    id: item.id,
    title: pub?.data.title ?? item.title,
    url: `/publications/${item.id}`,
    badge: (item.type ?? pub?.data.type),
    badgeClass: pubBadgeClass[item.type ?? pub?.data.type ?? ''] ?? pubBadgeClass.journal,
    description: pub?.data.venue ?? item.excerpt,
    metaYear: pub?.data.year ?? item.year,
    metaVenue: pub?.data.venue,
    __source: 'publication' as const,
  }
})
---

<VSCodeLayout title={title} lang={language as 'en' | 'id'} image={`/og/publications/${publication.id}.png`}>
  <JsonLd slot="head" data={scholarlyArticleJsonLd} />
  <div class="px-8 py-8">
    <article class="max-w-3xl">
      <div class="mb-6">
        <span class="inline-block px-2.5 py-0.5 text-xs font-mono font-medium rounded-full bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary/80 mb-3">
          {type}
        </span>
      </div>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-primary dark:text-gray-100 leading-tight mb-4">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-neutral-500 dark:text-gray-400 mb-4">
        <span>{year}</span>
        <span aria-hidden="true">·</span>
        <span>{venue}</span>
      </div>
      {
        authors.length > 0 && (
          <p class="text-neutral-600 dark:text-gray-300 mb-6">
            {authors.join(', ')}
          </p>
        )
      }
      <div class="flex flex-wrap gap-3">
        <a
          href={url}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium bg-primary text-white hover:bg-accent hover:text-primary transition-colors"
        >
          View Publication
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
          </svg>
        </a>
        {doi && (
          <a
            href={`https://doi.org/${doi}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium border border-neutral-300 dark:border-gray-600 text-neutral-700 dark:text-gray-300 hover:bg-neutral-50 dark:hover:bg-gray-800 transition-colors"
          >
            DOI: {doi}
          </a>
        )}
        {googleScholarUrl && (
          <a
            href={googleScholarUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium border border-neutral-300 dark:border-gray-600 text-neutral-700 dark:text-gray-300 hover:bg-neutral-50 dark:hover:bg-gray-800 transition-colors"
          >
            Google Scholar
          </a>
        )}
      </div>
      <CitationExport
        client:load
        title={title}
        year={year}
        type={type}
        venue={venue}
        authors={authors}
        url={url}
        doi={doi}
      />
      <ShareButtons client:load url={pubUrl} title={title} description={venue} lang={language as 'en' | 'id'} />
      <EditOnGitHub filePath={`src/content/publications/${publication.id}.md`} />
      <RelatedContent client:load items={relatedItems} context="publication" />
      <PageFeedback client:load pageType="publication" slug={publication.id} contentLang={language as 'en' | 'id'} />
    </article>
  </div>
</VSCodeLayout>
