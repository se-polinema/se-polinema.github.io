---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import BlogPostPage from '../../components/BlogPostPage.vue'
import TableOfContents from '../../components/TableOfContents.vue'
import JsonLd from '../../components/JsonLd.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, titleId, date, category, author } = post.data
const { Content } = await render(post)

const researchers = await getCollection('researchers')
const matchedResearcher = researchers.find((r) => r.data.name === author)

const origin = Astro.site?.origin ?? 'https://se-polinema.github.io'
const postUrl = new URL(Astro.url.pathname, origin).href
const imageUrl = post.data.image
  ? (post.data.image.startsWith('http') ? post.data.image : new URL(post.data.image, origin).href)
  : new URL('/og-default.svg', origin).href

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.lang === 'id' && titleId ? titleId : title,
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: origin,
  },
  datePublished: date.toISOString().split('T')[0],
  dateModified: date.toISOString().split('T')[0],
  url: postUrl,
  image: imageUrl,
  description: post.data.excerpt ?? undefined,
  inLanguage: post.data.lang,
  publisher: {
    '@type': 'Organization',
    name: 'Software Engineering Laboratory',
    url: origin,
  },
}
---

<VSCodeLayout
  title={title}
  description={post.data.excerpt ?? 'Software Engineering Laboratory news article.'}
  type="article"
  lang={post.data.lang as 'en' | 'id'}
  image={post.data.image ?? undefined}
>
  <JsonLd slot="head" data={blogPostingJsonLd} />
  <div class="px-8 py-6 flex gap-8">
    <div class="flex-1 min-w-0">
      <BlogPostPage
        client:load
        title={title}
        titleId={titleId}
        date={date}
        category={category}
        author={author}
        matchedResearcher={matchedResearcher
          ? { id: matchedResearcher.id, name: matchedResearcher.data.name, photo: matchedResearcher.data.photo }
          : undefined}
      />
      <div class="prose prose-slate max-w-none bilingual-post">
        <Content />
      </div>
    </div>
    <TableOfContents client:load />
  </div>
</VSCodeLayout>
