---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import BlogPostPage from '../../components/BlogPostPage.vue'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, titleId, date, category } = post.data
const { Content } = await render(post)
---

<VSCodeLayout title={title} description={post.data.excerpt ?? 'Software Engineering Laboratory news article.'}>
  <BlogPostPage client:load title={title} titleId={titleId} date={date} category={category}>
    <Content />
  </BlogPostPage>
</VSCodeLayout>
