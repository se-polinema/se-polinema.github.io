---
import Default from '../../layouts/Default.astro'
import Header from '../../components/Header.vue'
import Footer from '../../components/Footer.vue'
import BlogPostPage from '../../components/BlogPostPage.vue'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, titleId, date, category } = post.data
const { Content } = await render(post)
---

<Default title={title} description={post.data.excerpt ?? 'Software Engineering Laboratory news article.'}>
  <Header client:load />
  <BlogPostPage client:load title={title} titleId={titleId} date={date} category={category}>
    <Content />
  </BlogPostPage>
  <Footer client:load />
</Default>
