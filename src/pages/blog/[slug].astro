---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import BlogPostPage from '../../components/BlogPostPage.vue'
import TableOfContents from '../../components/TableOfContents.vue'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, titleId, date, category } = post.data
const { Content } = await render(post)
---

<VSCodeLayout
  title={title}
  description={post.data.excerpt ?? 'Software Engineering Laboratory news article.'}
  type="article"
  lang={post.data.lang as 'en' | 'id'}
  image={post.data.image ?? undefined}
>
  <div class="px-8 py-6 flex gap-8">
    <div class="flex-1 min-w-0">
      <BlogPostPage client:load title={title} titleId={titleId} date={date} category={category} />
      <div class="prose prose-slate max-w-none bilingual-post">
        <Content />
      </div>
    </div>
    <TableOfContents client:load />
  </div>
</VSCodeLayout>
