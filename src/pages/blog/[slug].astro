---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import BlogPostPage from '../../components/BlogPostPage.vue'
import TableOfContents from '../../components/TableOfContents.vue'
import CodeCopyButtons from '../../components/CodeCopyButtons.vue'
import JsonLd from '../../components/JsonLd.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, titleId, date, category, author } = post.data
const { Content } = await render(post)

const bodyText = post.body ?? ''
const wordCount = bodyText
  .replace(/[#*`_\[\]()>|{}.!\-:~=<>]/g, ' ')
  .replace(/<[^>]*>/g, '')
  .split(/\s+/)
  .filter(Boolean).length
const readingTime = Math.max(1, Math.ceil(wordCount / 200))

const researchers = await getCollection('researchers')
const matchedResearcher = researchers.find((r) => r.data.name === author)

const origin = Astro.site?.origin ?? 'https://se-polinema.github.io'
const postUrl = new URL(Astro.url.pathname, origin).href
const imageUrl = post.data.image
  ? (post.data.image.startsWith('http') ? post.data.image : new URL(post.data.image, origin).href)
  : new URL('/og-default.svg', origin).href

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.lang === 'id' && titleId ? titleId : title,
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: origin,
  },
  datePublished: date.toISOString().split('T')[0],
  dateModified: date.toISOString().split('T')[0],
  url: postUrl,
  image: imageUrl,
  description: post.data.excerpt ?? undefined,
  inLanguage: post.data.lang,
  publisher: {
    '@type': 'Organization',
    name: 'Software Engineering Laboratory',
    url: origin,
  },
}
---

<VSCodeLayout
  title={title}
  description={post.data.excerpt ?? 'Software Engineering Laboratory news article.'}
  type="article"
  lang={post.data.lang as 'en' | 'id'}
  image={post.data.image ?? undefined}
>
  <JsonLd slot="head" data={blogPostingJsonLd} />
  <div class="px-8 py-6 flex gap-8">
    <div class="flex-1 min-w-0">
      <BlogPostPage
        client:load
        title={title}
        titleId={titleId}
        date={date}
        category={category}
        author={author}
        readingTime={readingTime}
        matchedResearcher={matchedResearcher
          ? { id: matchedResearcher.id, name: matchedResearcher.data.name, photo: matchedResearcher.data.photo }
          : undefined}
      />
      <div class="prose prose-slate max-w-none bilingual-post">
        <Content />
      </div>
      <CodeCopyButtons client:load />
      <script>
        import mermaid from 'mermaid'

        // ── Config ────────────────────────────────────────────────────────
        function mermaidConfig(dark: boolean) {
          const light = {
            darkMode: false,
            background: '#ffffff',
            primaryColor: '#dbeafe',
            primaryTextColor: '#0f172a',
            primaryBorderColor: '#2563eb',
            lineColor: '#475569',
            secondaryColor: '#e2e8f0',
            tertiaryColor: '#f1f5f9',
            fontSize: '15px',
            actorBkg: '#dbeafe',
            actorTextColor: '#0f172a',
            actorBorder: '#2563eb',
            signalColor: '#475569',
            signalTextColor: '#0f172a',
            noteBkgColor: '#e2e8f0',
            noteTextColor: '#0f172a',
            noteBorderColor: '#2563eb',
            labelBoxBkgColor: '#f1f5f9',
            labelBoxBorderColor: '#2563eb',
            labelTextColor: '#0f172a',
            loopTextColor: '#0f172a',
            activationBorderColor: '#2563eb',
            activationBkgColor: '#dbeafe',
            sequenceNumberColor: '#0f172a',
          }
          const dk = {
            darkMode: true,
            background: 'transparent',
            primaryColor: '#1e3a5f',
            primaryTextColor: '#e5e7eb',
            primaryBorderColor: '#60a5fa',
            lineColor: '#94a3b8',
            secondaryColor: '#334155',
            tertiaryColor: '#1e293b',
            fontSize: '15px',
            actorBkg: '#1e3a5f',
            actorTextColor: '#e5e7eb',
            actorBorder: '#60a5fa',
            signalColor: '#94a3b8',
            signalTextColor: '#e5e7eb',
            noteBkgColor: '#334155',
            noteTextColor: '#e5e7eb',
            noteBorderColor: '#60a5fa',
            labelBoxBkgColor: '#1e293b',
            labelBoxBorderColor: '#60a5fa',
            labelTextColor: '#e5e7eb',
            loopTextColor: '#e5e7eb',
            activationBorderColor: '#60a5fa',
            activationBkgColor: '#1e3a5f',
            sequenceNumberColor: '#e5e7eb',
          }
          return {
            startOnLoad: false,
            securityLevel: 'loose' as const,
            theme: 'base' as const,
            themeVariables: dark ? dk : light,
            flowchart: { useMaxWidth: false, htmlLabels: true },
            sequence: { useMaxWidth: false },
            class: { useMaxWidth: false },
          }
        }

        // ── State ─────────────────────────────────────────────────────────
        const mermaidNodes: HTMLElement[] = []

        // ── Setup (once, synchronously) ───────────────────────────────────
        function setupDiagrams() {
          document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]').forEach((block) => {
            const src = block.textContent || ''

            const wrapper = document.createElement('div')
            wrapper.className = 'mermaid-diagram'

            const pre = document.createElement('pre')
            pre.className = 'mermaid'
            pre.textContent = src
            pre.dataset.src = src
            wrapper.appendChild(pre)

            // Expand button (shown on hover / always on touch)
            const btn = document.createElement('button')
            btn.className = 'mermaid-expand-btn'
            btn.setAttribute('aria-label', 'Open diagram fullscreen')
            btn.innerHTML =
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>'
            wrapper.appendChild(btn)

            btn.addEventListener('click', (e) => { e.stopPropagation(); openModal(pre) })
            wrapper.addEventListener('click', () => openModal(pre))

            block.replaceWith(wrapper)
            mermaidNodes.push(pre)
          })
        }

        // ── Render (async — safe to fire-and-forget) ─────────────────────
        async function render() {
          if (mermaidNodes.length === 0) return
          const dark = document.documentElement.classList.contains('dark')
          mermaid.initialize(mermaidConfig(dark))
          for (const node of mermaidNodes) {
            node.textContent = node.dataset.src ?? ''
            node.removeAttribute('data-processed')
          }
          await mermaid.run({ nodes: mermaidNodes })
        }

        // ── Modal state ───────────────────────────────────────────────────
        let modal: HTMLDivElement | null = null
        let stageEl: HTMLDivElement | null = null
        let stageWrapEl: HTMLDivElement | null = null
        let scale = 1
        let tx = 0
        let ty = 0
        let dragging = false
        let dragStart = { x: 0, y: 0, tx: 0, ty: 0 }
        let lastTrigger: HTMLElement | null = null

        function makeBtn(ariaLabel: string, svgHtml: string, onClick: () => void): HTMLButtonElement {
          const b = document.createElement('button')
          b.className = 'mermaid-modal-btn'
          b.setAttribute('aria-label', ariaLabel)
          b.innerHTML = svgHtml
          b.addEventListener('click', onClick)
          return b
        }

        function applyTransform() {
          if (stageEl) stageEl.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`
        }

        function resetTransform() {
          scale = 1; tx = 0; ty = 0
          applyTransform()
        }

        function initModal() {
          if (modal) return

          modal = document.createElement('div')
          modal.className = 'mermaid-modal'
          modal.setAttribute('role', 'dialog')
          modal.setAttribute('aria-modal', 'true')
          modal.setAttribute('aria-label', 'Diagram viewer')
          modal.setAttribute('tabindex', '-1')

          const backdrop = document.createElement('div')
          backdrop.className = 'mermaid-modal-backdrop'
          backdrop.addEventListener('click', closeModal)

          const container = document.createElement('div')
          container.className = 'mermaid-modal-container'

          const toolbar = document.createElement('div')
          toolbar.className = 'mermaid-modal-toolbar'

          toolbar.append(
            makeBtn('Zoom out',
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>',
              () => { scale = Math.max(0.25, scale - 0.25); applyTransform() }),
            makeBtn('Reset zoom',
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>',
              resetTransform),
            makeBtn('Zoom in',
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>',
              () => { scale = Math.min(8, scale + 0.25); applyTransform() }),
            makeBtn('Close',
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
              closeModal),
          )

          const stageWrap = document.createElement('div')
          stageWrap.className = 'mermaid-modal-stage-wrap'
          stageWrapEl = stageWrap

          stageEl = document.createElement('div')
          stageEl.className = 'mermaid-modal-stage'
          stageWrap.appendChild(stageEl)

          container.append(toolbar, stageWrap)
          modal.append(backdrop, container)
          document.body.appendChild(modal)

          // Keyboard shortcuts
          document.addEventListener('keydown', (e) => {
            if (!modal?.classList.contains('is-open')) return
            if (e.key === 'Escape') closeModal()
            if (e.key === '+' || e.key === '=') { scale = Math.min(8, scale + 0.25); applyTransform() }
            if (e.key === '-') { scale = Math.max(0.25, scale - 0.25); applyTransform() }
            if (e.key === '0') resetTransform()
          })

          // Pan via mouse drag on stage wrap
          stageWrap.addEventListener('mousedown', (e) => {
            if ((e.target as HTMLElement).closest('.mermaid-modal-btn')) return
            dragging = true
            dragStart = { x: e.clientX, y: e.clientY, tx, ty }
            stageWrap.classList.add('is-dragging')
            e.preventDefault()
          })
          window.addEventListener('mousemove', (e) => {
            if (!dragging) return
            tx = dragStart.tx + (e.clientX - dragStart.x)
            ty = dragStart.ty + (e.clientY - dragStart.y)
            applyTransform()
          })
          window.addEventListener('mouseup', () => {
            if (!dragging) return
            dragging = false
            stageWrap.classList.remove('is-dragging')
          })

          // Wheel zoom toward cursor
          stageWrap.addEventListener('wheel', (e) => {
            e.preventDefault()
            const rect = stageWrap.getBoundingClientRect()
            const cx = e.clientX - rect.left
            const cy = e.clientY - rect.top
            const delta = e.deltaY < 0 ? 0.15 : -0.15
            const newScale = Math.min(8, Math.max(0.25, scale + delta))
            const ratio = newScale / scale
            tx = cx + (tx - cx) * ratio
            ty = cy + (ty - cy) * ratio
            scale = newScale
            applyTransform()
          }, { passive: false })
        }

        function openModal(pre: HTMLElement) {
          initModal()
          const svg = pre.querySelector('svg')
          if (!svg) return
          const wrapper = pre.closest<HTMLElement>('.mermaid-diagram')
          lastTrigger = wrapper?.querySelector<HTMLElement>('.mermaid-expand-btn') ?? pre
          stageEl!.innerHTML = ''
          stageEl!.appendChild(svg.cloneNode(true))
          resetTransform()
          modal!.classList.add('is-open')
          document.body.style.overflow = 'hidden'
          modal!.focus()
        }

        function closeModal() {
          if (!modal) return
          modal.classList.remove('is-open')
          document.body.style.overflow = ''
          lastTrigger?.focus()
        }

        // ── Boot ──────────────────────────────────────────────────────────
        setupDiagrams()

        if (mermaidNodes.length > 0) {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => render())
          } else {
            render()
          }

          // Re-render when the site theme toggles (useTheme.ts flips html.dark)
          let prevDark = document.documentElement.classList.contains('dark')
          new MutationObserver(() => {
            const nowDark = document.documentElement.classList.contains('dark')
            if (nowDark !== prevDark) {
              prevDark = nowDark
              render()
            }
          }).observe(document.documentElement, { attributeFilter: ['class'] })
        }
      </script>
    </div>
    <TableOfContents client:load />
  </div>

  <style is:global>
    /* === Mermaid diagram wrapper === */
    .mermaid-diagram {
      position: relative;
      margin: 2.5rem 0;
      overflow-x: auto;
      text-align: center;
    }
    .mermaid-diagram svg {
      display: inline-block;
      height: auto;
      max-width: none;
    }

    /* Expand button — fades in on hover, always visible on touch */
    .mermaid-expand-btn {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      width: 2rem;
      height: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 1px solid rgba(0, 0, 0, 0.15);
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.85);
      color: #475569;
      cursor: pointer;
      opacity: 0;
      transition: opacity 0.15s, background 0.15s;
      z-index: 1;
      line-height: 1;
    }
    .mermaid-diagram:hover .mermaid-expand-btn,
    .mermaid-diagram:focus-within .mermaid-expand-btn {
      opacity: 1;
    }
    @media (hover: none) {
      .mermaid-expand-btn { opacity: 1; }
    }
    html.dark .mermaid-expand-btn {
      background: rgba(15, 23, 42, 0.85);
      color: #94a3b8;
      border-color: rgba(255, 255, 255, 0.12);
    }

    /* === Mermaid fullscreen modal === */
    .mermaid-modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      flex-direction: column;
    }
    .mermaid-modal.is-open {
      display: flex;
    }
    .mermaid-modal:focus {
      outline: none;
    }
    .mermaid-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.78);
    }
    .mermaid-modal-container {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      pointer-events: none;
    }
    .mermaid-modal-toolbar {
      position: absolute;
      top: 1rem;
      right: 1rem;
      display: flex;
      gap: 0.375rem;
      z-index: 1;
      pointer-events: all;
    }
    .mermaid-modal-btn {
      width: 2.25rem;
      height: 2.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 6px;
      background: rgba(15, 23, 42, 0.9);
      color: #e5e7eb;
      cursor: pointer;
      transition: background 0.15s;
      line-height: 1;
    }
    .mermaid-modal-btn:hover {
      background: rgba(30, 58, 138, 0.9);
    }
    .mermaid-modal-stage-wrap {
      flex: 1;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: all;
      cursor: grab;
    }
    .mermaid-modal-stage-wrap.is-dragging {
      cursor: grabbing;
    }
    .mermaid-modal-stage {
      transform-origin: center center;
      user-select: none;
      display: inline-block;
      will-change: transform;
    }
    .mermaid-modal-stage svg {
      display: block;
      max-width: none !important;
      height: auto;
    }
  </style>
</VSCodeLayout>
