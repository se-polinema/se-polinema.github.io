---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import BlogArchivePage from '../../components/BlogArchivePage.vue'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('blog')
const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    titleId: post.data.titleId,
    excerpt: post.data.excerpt,
    excerptId: post.data.excerptId,
    category: post.data.category,
    date: post.data.date,
  }))
---

<VSCodeLayout title="Blog Archive" description="News, announcements, and event updates from the Software Engineering Laboratory.">
  <BlogArchivePage client:load posts={posts} />
</VSCodeLayout>
