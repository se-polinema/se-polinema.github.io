---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import BlogArchivePage from '../../components/BlogArchivePage.vue'

// Post data is intentionally NOT fetched here: BlogArchivePage.vue
// fetches it client-side from /api/blog-index.json instead, so this
// page's own HTML stays constant-size as the blog grows (see the
// pagination plan). The category/tag archive routes still pass `posts`
// directly since those are small, pre-filtered, statically generated.
---

<VSCodeLayout title="Blog Archive" description="Articles, tutorials, announcements, and event updates from the Software Engineering Laboratory.">
  <BlogArchivePage client:load />
</VSCodeLayout>
