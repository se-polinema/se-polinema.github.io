---
import VSCodeLayout from '../../layouts/VSCodeLayout.astro'
import ShowcaseSubmissionForm from '../../components/ShowcaseSubmissionForm.vue'
import { withBase } from '../../lib/paths'
---

<VSCodeLayout
  title="Add Your Project"
  description="Submit your own project or product to the Software Engineering Laboratory showcase."
>
  <div class="px-8 py-5">
    <a
      href={withBase('/showcase')}
      class="inline-flex items-center gap-1 text-xs font-mono text-primary/40 dark:text-gray-500 hover:text-primary dark:hover:text-gray-100 transition-colors mb-6"
    >
      &larr; Back to Showcase
    </a>
    <h1>Add Your Project</h1>
    <p class="text-neutral-500 dark:text-gray-400 text-sm mt-1 mb-8">
      Submit your own project or product for the showcase. It will be reviewed by an admin before it appears publicly.
    </p>
    <ShowcaseSubmissionForm client:load />
  </div>
</VSCodeLayout>
