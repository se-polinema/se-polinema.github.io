# Supabase: get these from your project's Settings → API page
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile site key (safe to expose; it's the public half of
# the widget). Used by the newsletter, alumni submission, and event
# registration forms. Get it from the Cloudflare dashboard → Turnstile.
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server-side only (for deploy-supabase.yml workflow, never expose to browser)
SUPABASE_ACCESS_TOKEN=your-access-token
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub OAuth App credentials (Settings → Developer settings → OAuth Apps).
# Callback URL to register on the GitHub OAuth App:
#   https://<SUPABASE_PROJECT_REF>.supabase.co/auth/v1/callback
# Server-side only: deploy-supabase.yml uses these to enable the GitHub
# provider on the Supabase project via the Management API.
SUPABASE_AUTH_GITHUB_CLIENT_ID=your-github-oauth-client-id
SUPABASE_AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# Cloudflare Turnstile secret key (the private half; never expose to the
# browser). Not an Astro build var: deploy-supabase.yml pushes this to the
# Supabase project as an Edge Function secret (`supabase secrets set`) and
# as the GoTrue captcha secret via the Management API.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
